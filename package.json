{
  "name": "nlpchat-workspace",
  "version": "1.0.0",
  "description": "NLPChat - Production-quality WhatsApp-style web app with automatic message normalization",
  "bin": {
    "nlp": "./bin/nlp.js"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "start": "node ./bin/nlp.js start",
    "dev": "node ./bin/nlp.js start",
    "backend": "npm run --prefix backend dev",
    "frontend": "npm run --prefix frontend dev",
    "test": "npm test --prefix backend",
    "test:watch": "npm run --prefix backend test:watch",
    "seed": "npm run --prefix backend seed",
    "build": "npm run --prefix frontend build",
    "serve": "node backend/src/index.js",
    "share": "node ./bin/nlp.js share",
    "live": "node ./bin/nlp.js share",
    "tunnel": "npx --yes localtunnel --port 5000"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
