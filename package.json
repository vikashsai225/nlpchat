{
  "name": "nlpchat-workspace",
  "version": "1.0.0",
  "description": "NLPChat - Production-quality WhatsApp-style web app with automatic message normalization",
  "bin": {
    "nlp": "./bin/nlp.js"
  },
  "scripts": {
    "build": "cd backend && npm install --production",
    "start": "node backend/src/index.js",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev": "node ./bin/nlp.js start",
    "nlp": "node ./bin/nlp.js",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "test": "cd backend && npm test",
    "test:watch": "cd backend && npm run test:watch",
    "seed": "cd backend && npm run seed",
    "serve": "node backend/src/index.js",
    "share": "node ./bin/nlp.js share",
    "live": "node ./bin/nlp.js share",
    "tunnel": "npx --yes localtunnel --port 5000"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
