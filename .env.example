# ====================================================================
# NLPChat Environment Configuration Template
# ====================================================================

# Port for Backend Server
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=nlpchat_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration
# Default: Zero-configuration built-in SQLite (stored at ./nlpchat.db)
# Production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/nlpchat
SQLITE_PATH=./nlpchat.db

# AI Provider API Keys (Strictly backend only - Never exposed to frontend)
# If provided, NLPChat queries the LLM using the official chat normalizer prompt.
# If left empty, NLPChat automatically runs using the comprehensive local fallback dictionary & rule engine!
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default AI Model (e.g., gemini-1.5-flash, gpt-4o-mini, claude-3-haiku-20240307)
AI_MODEL=gemini-1.5-flash

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
